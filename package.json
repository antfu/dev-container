{
  "name": "dev-container",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Compose any agent or command into a network-caged container whose tokens never enter it",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/dev-container#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/dev-container.git"
  },
  "bugs": "https://github.com/antfu/dev-container/issues",
  "keywords": [
    "docker",
    "compose",
    "sandbox",
    "secrets",
    "agents",
    "mitmproxy"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "dev-container": "./dist/cli.mjs"
  },
  "files": [
    "broker/Dockerfile",
    "broker/addon.py",
    "broker/entrypoint.sh",
    "broker/rules.py",
    "dist",
    "relay",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "nr build",
    "release": "bumpp",
    "start": "tsx src/cli.ts",
    "test": "pnpm run build && vitest",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test --run && pnpm run test:broker",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills experimental_sync -y",
    "test:broker": "python3 -m unittest discover -s broker"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the CLI from source",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills",
    "test:broker": "Run the broker policy tests"
  },
  "dependencies": {
    "@clack/prompts": "catalog:prod",
    "@hono/node-server": "catalog:prod",
    "@hono/zod-openapi": "catalog:prod",
    "defu": "catalog:prod",
    "hono": "catalog:prod",
    "nostics": "catalog:prod",
    "std-env": "catalog:prod",
    "unconfig": "catalog:prod",
    "yaml": "catalog:prod",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/skills": "catalog:agentic",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
