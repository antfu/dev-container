# Secrets. Copy to `.env.secret`, which stays on the host and is git-ignored.
# Tailscale auth key for the sidecar.
TS_AUTHKEY=
# Checked by the daemon itself, so it lives in the cage.
PASEO_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Password for the Chromium desktop.
BROWSER_PASSWORD=
# Optional. A GitHub token for `gh` and `git push`; the cage only sees a placeholder.
GITHUB_TOKEN=
