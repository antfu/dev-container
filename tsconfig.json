{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "paths": {
      "@antfu/dev-container": ["./src/index.ts"]
    },
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  // The dashboard is checked by its own vue-tsc config, with the DOM types it needs.
  "exclude": ["packages/dashboard", "dist", "node_modules"]
}
