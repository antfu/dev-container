{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@antfu/utils", "taze", "@antfu/skills"],
  "workspaces": {
    ".": { "project": ["src/**/*.ts"] },
    "packages/dashboard": {
      "entry": ["dashboard.html"],
      "project": ["src/**/*.{ts,vue}"],
      // Loaded by name through `presetIcons`, never imported.
      "ignoreDependencies": ["@iconify-json/ph"]
    }
  }
}
